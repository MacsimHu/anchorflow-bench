{
  "schema": "anchorflow-result-contract-v1",
  "status": "contract specification, not a completed result",
  "required_fields": [
    "protocol_sha256",
    "code_sha256",
    "data_manifest_sha256",
    "split_manifest_sha256",
    "preprocessing_sha256",
    "case",
    "regime",
    "method",
    "seed",
    "recipe_sha256",
    "checkpoint_sha256",
    "checkpoint_selection_rule",
    "actual_updates",
    "all_declared_runs",
    "runtime",
    "metric_schema",
    "test_partition_counts",
    "metrics",
    "exit_status",
    "failure_record",
    "artifact_manifest_sha256"
  ],
  "canonical_rpbl_schema": "pfdelta_recorded_orientation_throughput_percent_v1",
  "MSE_schema": "sum_of_PQ_PV_reference_branch_per_scenario_group_means",
  "PBL_units": "pu_on_100MVA",
  "rPBL_units": "percent",
  "partitions_never_pooled": ["feasible", "near_infeasible"],
  "future_result_path": "results/<protocol-sha>/<case>/<regime>/<method>/<seed>.json",
  "raw_predictions_in_public_repo": false,
  "credentials_in_public_repo": false,
  "failure_is_not_a_completed_result": true,
  "partial_checkpoint_is_not_final_TEST": true,
  "historical_different_denominator_is_not_accepted_as_canonical_rPBL": true,
  "receiver_must_check": [
    "exact finite numeric values and metric schema",
    "admitted frozen protocol and code/data identities",
    "sample and topology counts",
    "all declared seeds without favorable selection",
    "same inference for MSE/PBL/rPBL",
    "no stale overwrite or duplicate coordinate",
    "artifact hashes before ingestion",
    "runtime/backend differences explicitly labeled"
  ]
}
